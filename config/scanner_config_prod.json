{
  "scanner": {
    "_comment": "针对 6核 Xeon E5-2683 v4 / 8GB RAM 优化",
    "io_thread_count": 6,
    "batch_size": 80000,
    "result_batch_size": 2000,
    "dns_timeout_ms": 2000,
    "probe_timeout_ms": 3000,
    "retry_count": 1,
    "only_success": true,
    "max_work_count": 0,
    "targets_max_size": 0,
    "result_queue_max_size": 0,
    "metrics_port": 9080
  },
  "protocols": {
    "_comment": "所有协议默认 disabled，通过 --protocols <NAME> 单选; 超时按协议特点设置",
    "SMTP": {
      "enabled": false,
      "ports": [25, 465, 587, 2525],
      "timeout_ms": 5000
    },
    "POP3": {
      "enabled": false,
      "ports": [110, 995],
      "timeout_ms": 5000
    },
    "IMAP": {
      "enabled": false,
      "ports": [143, 993],
      "timeout_ms": 5000
    },
    "HTTP": {
      "enabled": false,
      "ports": [80, 443, 8080, 8443],
      "timeout_ms": 3000
    },
    "FTP": {
      "enabled": false,
      "ports": [21],
      "timeout_ms": 5000
    },
    "SSH": {
      "enabled": false,
      "ports": [22],
      "timeout_ms": 3000
    },
    "TELNET": {
      "enabled": false,
      "ports": [23],
      "timeout_ms": 5000
    },
    "REDIS": {
      "enabled": false,
      "ports": [6379, 6380],
      "timeout_ms": 3000
    },
    "RTSP": {
      "enabled": false,
      "ports": [554, 8554],
      "timeout_ms": 3000
    },
    "SIP": {
      "enabled": false,
      "ports": [5060, 5061],
      "timeout_ms": 3000
    },
    "MYSQL": {
      "enabled": false,
      "ports": [3306],
      "timeout_ms": 5000
    }
  },
  "dns": {
    "resolver_type": "null",
    "max_mx_records": 16,
    "timeout_ms": 5000
  },
  "output": {
    "format": ["json"],
    "write_mode": "stream",
    "directory": "./output",
    "enable_json": true,
    "enable_csv": false,
    "enable_report": false,
    "to_console": false
  },
  "logging": {
    "level": "INFO",
    "console_enabled": false,
    "file_enabled": true,
    "file_path": "./logs/scanner.log"
  },
  "vendor": {
    "enabled": true,
    "pattern_file": "./config/vendors.json",
    "similarity_threshold": 0.7
  }
}
