[Unit]
Description=Scanner dead-man switch: stops scanners if heartbeat file is stale

[Service]
Type=oneshot
ExecStart=/bin/bash -c '\
  HEARTBEAT=/tmp/aliyun_heartbeat; \
  MAX_AGE_SEC=300; \
  if [ ! -f "$$HEARTBEAT" ]; then \
    echo "FATAL: Heartbeat file $$HEARTBEAT does not exist, stopping all scanners"; \
    systemctl stop "scanner@*.service" 2>/dev/null; \
    exit 0; \
  fi; \
  NOW=$$(date +%%s); \
  FILE_AGE=$$(stat -c %%Y "$$HEARTBEAT"); \
  AGE=$$((NOW - FILE_AGE)); \
  if [ "$$AGE" -gt "$$MAX_AGE_SEC" ]; then \
    echo "FATAL: Heartbeat stale ($${AGE}s > $${MAX_AGE_SEC}s), stopping all scanners"; \
    systemctl stop "scanner@*.service" 2>/dev/null; \
  fi'
